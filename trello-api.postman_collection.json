    {
      "name": "Delete List",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Close the list before deleting it (Trello requires lists to be closed/archived first)\nconst baseUrl = pm.environment.get(\"base-url\");\nconst listId = pm.environment.get(\"ListId\");\nconst key = pm.environment.get(\"key\");\nconst token = pm.environment.get(\"token\");\n\nconst closeListRequest = {\n    url: `${baseUrl}/1/lists/${listId}?closed=true&key=${key}&token=${token}`,\n    method: \"PUT\"\n};\n\npm.sendRequest(closeListRequest, function (err, response) {\n    if (err) {\n        console.error(\"Failed to close list:\", err);\n    } else if (response.code !== 200) {\n        console.warn(\"Close list responded with status:\", response.code, response.text());\n    } else {\n        console.log(\"List closed successfully. Proceeding with deletion...\");\n    }\n});"
            ]
          }
        },
